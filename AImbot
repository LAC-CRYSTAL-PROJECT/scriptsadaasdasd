		Thickness = 1
	},
	Aimbot = {
		Enabled = true,
		Smoothness = 0.3,
		WallCheck = true,
		TeamCheck = false
	}
}
local Settings = getgenv().Settings;
local Players = game:GetService("Players")
local Camera = workspace.CurrentCamera;
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Circle = Drawing.new("Circle")
Circle.Radius = Settings.Circle.Radius;
Circle.Color = Settings.Circle.Color;
Circle.Thickness = Settings.Circle.Thickness;
Circle.Filled = false;
Circle.Visible = true;
local function IsVisible(targetPos)
	if not Settings.Aimbot.WallCheck then
		return true
	end;
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Blacklist;
	rayParams.FilterDescendantsInstances = {
		Players.LocalPlayer.Character
	}
	local direction = (targetPos - Camera.CFrame.Position)
	local raycastResult = workspace:Raycast(Camera.CFrame.Position, direction, rayParams)
	if raycastResult then
		local hitPart = raycastResult.Instance;
		for _, player in ipairs(Players:GetPlayers()) do
			if player.Character and player.Character:FindFirstChild("Head") then
				if hitPart:IsDescendantOf(player.Character) then
					return true
				end
			end
		end;
		return false
	else
		return true
	end
end;
RunService.RenderStepped:Connect(function()
	if not Settings.Aimbot.Enabled then
		return
	end;
	local mousePos = UIS:GetMouseLocation()
	Circle.Position = Vector2.new(mousePos.X, mousePos.Y)
	Circle.Radius = Settings.Circle.Radius;
	Circle.Color = Settings.Circle.Color;
	Circle.Thickness = Settings.Circle.Thickness;
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= Players.LocalPlayer and player.Character and player.Character:FindFirstChild("Head") then
			if not Settings.Aimbot.TeamCheck or player.Team ~= Players.LocalPlayer.Team then
				local headPos = player.Character.Head.Position;
				if IsVisible(headPos) then
					local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
					if onScreen then
						local distance = (Vector2.new(screenPos.X, screenPos.Y) - Circle.Position).Magnitude;
						if distance <= Circle.Radius then
							local deltaX = (screenPos.X - mousePos.X) * Settings.Aimbot.Smoothness;
							local deltaY = (screenPos.Y - mousePos.Y) * Settings.Aimbot.Smoothness;
							mousemoverel(deltaX, deltaY)
							break
						end
					end
				end
			end
		end
	end
end)
